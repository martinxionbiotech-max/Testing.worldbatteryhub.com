---
import standards from '../../data/standards.json';

export function getStaticPaths() {
  return standards.standards.map((s) => ({
    params: { standard: s.id },
    props: { standard: s },
  }));
}

const { standard } = Astro.props;
const SITE = 'https://testing.worldbatteryhub.com';
const url = `${SITE}/standards/${standard.id}/`;

const jsonLd = {
  '@type': 'TechArticle',
  '@id': `${url}#article`,
  headline: `${standard.code} — ${standard.object}`,
  url,
  about: `${standard.code} battery testing standard`,
  articleSection: 'Battery Testing Standards',
  dateModified: '2026-09-15',
  inLanguage: 'en',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{standard.code} — {standard.object} | World Battery Hub</title>
    <meta name="description" content={`${standard.code} (${standard.region}) — ${standard.object} for ${standard.chemistry} batteries. ${standard.scope}`} />
    <link rel="canonical" href={url} />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; color: #1e293b; line-height: 1.6; }
      .container { max-width: 900px; margin: 0 auto; padding: 20px; }
      h1, h2 { color: #0f1f3d; }
      a { color: #1d4ed8; }
      .muted { color: #64748b; font-size: 0.85rem; }
      .box { background: #eff6ff; border-left: 4px solid #1d4ed8; padding: 12px 16px; margin: 14px 0; }
      table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e9f0; }
      th { color: #0f1f3d; width: 32%; }
      .related { display: flex; flex-wrap: wrap; gap: 8px; }
      .related a { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; padding: 4px 10px; text-decoration: none; font-size: 0.9rem; }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
    <script type="application/ld+json" set:html={"{\"@context\": \"https://schema.org\", \"@type\": \"WebPage\", \"@id\": \"https://testing.worldbatteryhub.com/standards/\", \"url\": \"https://testing.worldbatteryhub.com/standards/\", \"name\": \"Standards\", \"publisher\": {\"@id\": \"https://worldbatteryhub.com/#organization\"}, \"isPartOf\": {\"@id\": \"https://testing.worldbatteryhub.com/\"}}"} />
    <script type="application/ld+json" set:html={"{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Battery Testing\", \"item\": \"https://testing.worldbatteryhub.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Standards\", \"item\": \"https://testing.worldbatteryhub.com/standards/\"}]}"} />
  </head>
  <body>
    <div class="container">
      <p class="muted"><a href="/">← Testing Methods</a> · Entity: <strong>TestingStandard</strong></p>
      <h1>{standard.code}</h1>
      <p class="muted">{standard.object} · Region: {standard.region}</p>

      <div class="box">
        <strong>Direct answer:</strong> {standard.code} is a {standard.region.toLowerCase()} standard for
        <strong>{standard.object}</strong> of <strong>{standard.chemistry}</strong> batteries. {standard.scope}
      </div>

      <h2>At a glance</h2>
      <table>
        <tbody>
          <tr><th>Standard</th><td>{standard.code}</td></tr>
          <tr><th>Region</th><td>{standard.region}</td></tr>
          <tr><th>Battery chemistry</th><td>{standard.chemistry}</td></tr>
          <tr><th>Test object</th><td>{standard.object}</td></tr>
          <tr><th>Scope</th><td>{standard.scope}</td></tr>
        </tbody>
      </table>

      <h2>Related</h2>
      <div class="related">
        <a href="/cca-testing/">CCA testing</a>
        <a href="/capacity-testing/">Capacity testing</a>
        <a href="/cycle-safety/">Cycle &amp; safety</a>
        <a href="https://data.worldbatteryhub.com/cca/">CCA reference data</a>
        <a href="https://worldbatteryhub.com/lead-acid/cca/what-is-cca/">What is CCA</a>
        <a href="https://technology.worldbatteryhub.com/formation-charging/">Formation &amp; charging</a>
      </div>

      <p class="muted">Return to <a href="https://testing.worldbatteryhub.com">Battery Testing Methods</a> · <a href="https://worldbatteryhub.com">World Battery Hub</a>. Informational, not purchasing advice.</p>
    </div>
  </body>
</html>
